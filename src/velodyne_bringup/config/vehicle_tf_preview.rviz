Panels:
- Class: rviz_common/Displays
  Name: Displays
  Property Tree Widget:
    Expanded:
    - /Global Options1
    - /TF1
    - /Mount geometry1
    Splitter Ratio: 0.52
- Class: rviz_common/Views
  Name: Views
Visualization Manager:
  Class: ''
  Displays:
  - Class: rviz_default_plugins/Grid
    Name: Grid (10 cm, base Z=0)
    Enabled: true
    Value: true
    Cell Size: 0.1
    Plane Cell Count: 30
    Color: 90; 100; 110
    Alpha: 0.35
    Reference Frame: <Fixed Frame>
    Plane: XY
    Line Style:
      Value: Lines
      Line Width: 0.001
  - Class: rviz_default_plugins/TF
    Name: TF
    Enabled: true
    Value: true
    Frames:
      All Enabled: true
    Marker Scale: 0.22
    Show Axes: true
    Show Arrows: false
    Show Names: false
    Update Interval: 0
    Frame Timeout: 15
  - Class: rviz_default_plugins/MarkerArray
    Name: Whole vehicle geometry
    Enabled: true
    Value: true
    Topic:
      Value: /lidar_camera_tf_preview/markers
      Depth: 1
      Durability Policy: Transient Local
      History Policy: Keep Last
      Reliability Policy: Reliable
    Queue Size: 10
  Enabled: true
  Global Options:
    Fixed Frame: base_link
    Background Color: 24; 28; 35
    Frame Rate: 30
  Name: root
  Tools:
  - Class: rviz_default_plugins/Interact
  - Class: rviz_default_plugins/MoveCamera
  - Class: rviz_default_plugins/Select
  - Class: rviz_default_plugins/FocusCamera
  - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: Whole vehicle 3D
      Target Frame: base_link
      Distance: 3.7
      Pitch: 0.3
      Yaw: -0.95
      Focal Point:
        X: -0.3
        Y: 0.0
        Z: 0.65
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.01
      Near Clip Distance: 0.005
      Invert Z Axis: false
    Saved:
    - Class: rviz_default_plugins/Orbit
      Name: Vehicle XZ side
      Target Frame: base_link
      Distance: 3.5
      Pitch: 0.0
      Yaw: -1.5707963268
      Focal Point:
        X: -0.3
        Y: 0.0
        Z: 0.65
      Near Clip Distance: 0.005
    - Class: rviz_default_plugins/Orbit
      Name: Vehicle XY top
      Target Frame: base_link
      Distance: 3.2
      Pitch: 1.5707
      Yaw: -1.5707963268
      Focal Point:
        X: -0.3
        Y: 0.0
        Z: 0.5
      Near Clip Distance: 0.005
    - Class: rviz_default_plugins/Orbit
      Name: Sensor mount detail
      Target Frame: velodyne
      Distance: 0.95
      Pitch: 0.4
      Yaw: -0.95
      Focal Point:
        X: 0.12
        Y: 0.025
        Z: -0.025
      Near Clip Distance: 0.005
Window Geometry:
  Width: 1440
  Height: 950
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false

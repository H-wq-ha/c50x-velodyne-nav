Panels:
  - Class: rviz_common/Displays
    Name: Displays
    Property Tree Widget:
      Expanded:
        - /Global Options1
        - /TF1
        - /Mount geometry1
      Splitter Ratio: 0.52
  - Class: rviz_common/Views
    Name: Views
Visualization Manager:
  Class: ""
  Displays:
    - Class: rviz_default_plugins/Grid
      Name: Grid (5 cm)
      Enabled: true
      Value: true
      Cell Size: 0.05
      Plane Cell Count: 20
      Color: 90; 100; 110
      Alpha: 0.35
      Reference Frame: <Fixed Frame>
      Plane: XY
      Line Style:
        Value: Lines
        Line Width: 0.001
    - Class: rviz_default_plugins/TF
      Name: TF
      Enabled: true
      Value: true
      Frames:
        All Enabled: true
      Marker Scale: 0.1
      Show Axes: true
      Show Arrows: false
      Show Names: false
      Update Interval: 0
      Frame Timeout: 15
    - Class: rviz_default_plugins/MarkerArray
      Name: Mount geometry
      Enabled: true
      Value: true
      Topic:
        Value: /lidar_camera_tf_preview/markers
        Depth: 1
        Durability Policy: Transient Local
        History Policy: Keep Last
        Reliability Policy: Reliable
      Queue Size: 10
  Enabled: true
  Global Options:
    Fixed Frame: velodyne
    Background Color: 24; 28; 35
    Frame Rate: 30
  Name: root
  Tools:
    - Class: rviz_default_plugins/Interact
    - Class: rviz_default_plugins/MoveCamera
    - Class: rviz_default_plugins/Select
    - Class: rviz_default_plugins/FocusCamera
    - Class: rviz_default_plugins/Measure
  Views:
    Current:
      Class: rviz_default_plugins/Orbit
      Name: 3D mount view
      Target Frame: velodyne
      Distance: 0.95
      Pitch: 0.4
      Yaw: -0.95
      Focal Point:
        X: 0.12
        Y: 0.025
        Z: -0.025
      Focal Shape Fixed Size: true
      Focal Shape Size: 0.01
      Near Clip Distance: 0.005
      Invert Z Axis: false
    Saved:
      - Class: rviz_default_plugins/Orbit
        Name: XZ side - check 50 deg downward
        Target Frame: velodyne
        Distance: 0.85
        Pitch: 0
        Yaw: -1.5707963268
        Focal Point:
          X: 0.14
          Y: 0.03
          Z: -0.045
        Near Clip Distance: 0.005
      - Class: rviz_default_plugins/Orbit
        Name: XY top - check same heading
        Target Frame: velodyne
        Distance: 0.75
        Pitch: 1.5707
        Yaw: -1.5707963268
        Focal Point:
          X: 0.12
          Y: 0.025
          Z: 0
        Near Clip Distance: 0.005
Window Geometry:
  Width: 1440
  Height: 950
  X: 40
  Y: 40
  Hide Left Dock: false
  Hide Right Dock: false
